# ---- Database ----
POSTGRES_USER=cyber
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cyberassist
# Host port for the Docker database (use 5433 if a local PostgreSQL already uses 5432)
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cyber:change-me@localhost:5432/cyberassist

# ---- LLM provider: mock | openai | anthropic ----
# Groq example: LLM_PROVIDER=openai  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-120b
# "openai" works with any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Ollama, LM Studio)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60

# ---- Embeddings: hash (offline, lexical) | local (sentence-transformers, semantic) | openai ----
# local: pip install -r backend/requirements-ml.txt (Docker: INSTALL_ML=true)
#        EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
# Must match the vector column created by the migration (change both together)
EMBEDDING_DIM=384

# ---- RAG ----
RAG_TOP_K=5
# Sources whose last_verified date is older than this are shown as stale
SOURCE_MAX_AGE_DAYS=180
# hash embeddings: ~0.05; semantic (local/openai) embeddings: ~0.25
RAG_MIN_SCORE=0.05

# ---- App ----
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
NEXT_PUBLIC_API_URL=http://localhost:8000

# Build the Docker backend with local embedding support
INSTALL_ML=false
